+class RevenueExcludeTest(unittest.TestCase):
+    """Клубный конфиг может исключать вид продаж из revenue с какой-то даты (см. docs/metrics.md)."""
+
+    def setUp(self):
+        self.conn = connect()
+        create_schema(self.conn)
+        self.conn.executemany(
+            "INSERT INTO clubs VALUES (?, ?, ?)",
+            [(1, "Клуб", "2020-01-01")],
+        )
+        self.conn.executemany(
+            "INSERT INTO sales VALUES (?, ?, ?, ?, ?, ?, ?)",
+            [
+                (1, 1, None, "2026-04-20", "bar", 10000, "own"),
+                (2, 1, None, "2026-05-10", "bar", 20000, "own"),
+                (3, 1, 1, "2026-05-11", "membership", 50000, "own"),
+            ],
+        )
+        self.conn.commit()
+        self.cfg = ClientConfig(
+            slug="test",
+            name="Тест",
+            partner_channels=[],
+            clubs={1: {"revenue_exclude": [{"kind": "bar", "from": "2026-05-01"}]}},
+        )
+
+    def test_excluded_kind_dropped_from_report_month_onward(self):
+        report = club_monthly_report(self.conn, self.cfg, 1, "2026-05")
+        self.assertEqual(report["revenue"], 500.0)  # только membership, бар исключён
+
+    def test_earlier_month_unaffected(self):
+        report = club_monthly_report(self.conn, self.cfg, 1, "2026-04")
+        self.assertEqual(report["revenue"], 100.0)  # бар за апрель ещё считается
+
+
