+def _trial_conversion(conn: sqlite3.Connection, club_id: int, start: str, end: str) -> float | None:
+    """Доля когорты месяца [start, end), купившей абонемент в день первого пробного
+    визита или в следующие 14 календарных дней. None, если когорта пустая."""
+    rows = conn.execute(
+        """
+        WITH first_trial AS (
+            SELECT person_id, MIN(visit_date) AS first_trial_date
+            FROM visits
+            WHERE club_id = ? AND visit_type IN ('trial', 'guest_pass')
+            GROUP BY person_id
+        )
+        SELECT EXISTS (
+            SELECT 1 FROM sales s
+            WHERE s.club_id = ? AND s.person_id = ft.person_id AND s.kind = 'membership'
+              AND s.sale_date >= ft.first_trial_date
+              AND s.sale_date <= date(ft.first_trial_date, '+14 days')
+        )
+        FROM first_trial ft
+        WHERE ft.first_trial_date >= ? AND ft.first_trial_date < ?
+        """,
+        (club_id, club_id, start, end),
+    ).fetchall()
+
+    if not rows:
+        return None
+    return round(sum(row[0] for row in rows) / len(rows), 3)
+
