+# Гостевые визиты считаются пробными только с этой даты (docs/metrics.md).
+_GUEST_PASS_AS_TRIAL_SINCE = "2025-01-01"
+
+
+def _trial_conversion(conn: sqlite3.Connection, club_id: int, start: str, end: str) -> float | None:
+    """Доля когорты пробных визитов месяца [start, end), купившей абонемент
+    в день первого пробного визита или в следующие 14 календарных дней.
+    """
+    row = conn.execute(
+        """
+        WITH first_trial AS (
+            SELECT person_id, MIN(visit_date) AS trial_date
+            FROM visits
+            WHERE club_id = ?
+              AND (visit_type = 'trial'
+                   OR (visit_type = 'guest_pass' AND visit_date >= ?))
+            GROUP BY person_id
+        ),
+        cohort AS (
+            SELECT person_id, trial_date
+            FROM first_trial
+            WHERE trial_date >= ? AND trial_date < ?
+        )
+        SELECT
+            COUNT(*),
+            SUM(
+                CASE WHEN EXISTS (
+                    SELECT 1 FROM sales
+                    WHERE sales.club_id = ?
+                      AND sales.person_id = cohort.person_id
+                      AND sales.kind = 'membership'
+                      AND sales.sale_date >= cohort.trial_date
+                      AND sales.sale_date <= date(cohort.trial_date, '+14 days')
+                ) THEN 1 ELSE 0 END
+            )
+        FROM cohort
+        """,
+        (club_id, _GUEST_PASS_AS_TRIAL_SINCE, start, end, club_id),
+    ).fetchone()
+
+    cohort_size, converted = row
+    if not cohort_size:
+        return None
+    return round((converted or 0) / cohort_size, 3)
+
