 def _month_bounds(month: str) -> tuple[str, str]:
@@ -72,26 +72,59 @@ def club_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, club_id: in
 
 
 def trainer_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, trainer_id: int, month: str) -> dict:
+    """Тренировки вдвоём (assistant_trainer_id) делятся между парой тренеров:
+    выручка — поровну через split_evenly (лишняя копейка основному тренеру),
+    счётчик `sessions` — целиком, по очереди внутри пары (чтобы разница была не больше одной
+    и ни строки, ни итоги клуба/сети не задваивались).
+    Самоассист (assistant_trainer_id == trainer_id, брак в выгрузке) считается обычной одиночной
+    тренировкой.
+    """
     start, end = _month_bounds(month)
     period = (trainer_id, start, end)
 
-    sessions = _scalar(
+    solo_sessions = _scalar(
         conn,
-        "SELECT COUNT(*) FROM sessions WHERE trainer_id = ? AND session_date >= ? AND session_date < ?",
+        "SELECT COUNT(*) FROM sessions WHERE trainer_id = ? AND session_date >= ? AND session_date < ?"
+        " AND (assistant_trainer_id IS NULL OR assistant_trainer_id = trainer_id)",
         period,
     )
-    pt_revenue = _scalar(
+    solo_revenue = _scalar(
         conn,
         "SELECT SUM(s.amount_kop) FROM sessions ss JOIN sales s ON s.id = ss.sale_id"
-        " WHERE ss.trainer_id = ? AND ss.session_date >= ? AND ss.session_date < ?",
+        " WHERE ss.trainer_id = ? AND ss.session_date >= ? AND ss.session_date < ?"
+        " AND (ss.assistant_trainer_id IS NULL OR ss.assistant_trainer_id = ss.trainer_id)",
         period,
     )
 
+    shared_rows = conn.execute(
+        "SELECT ss.id, ss.trainer_id, ss.assistant_trainer_id, s.amount_kop"
+        " FROM sessions ss JOIN sales s ON s.id = ss.sale_id"
+        " WHERE ss.session_date >= ? AND ss.session_date < ?"
+        " AND ss.assistant_trainer_id IS NOT NULL AND ss.assistant_trainer_id != ss.trainer_id"
+        " AND (ss.trainer_id = ? OR ss.assistant_trainer_id = ?)"
+        " ORDER BY ss.id",
+        (start, end, trainer_id, trainer_id),
+    ).fetchall()
+
+    pairs: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for _session_id, main_id, assistant_id, amount_kop in shared_rows:
+        pair = (min(main_id, assistant_id), max(main_id, assistant_id))
+        pairs.setdefault(pair, []).append((main_id, amount_kop))
+
+    shared_sessions = 0
+    shared_revenue = 0
+    for (low, high), items in pairs.items():
+        for index, (main_id, amount_kop) in enumerate(items):
+            if (low if index % 2 == 0 else high) == trainer_id:
+                shared_sessions += 1
+            main_share, assistant_share = split_evenly(amount_kop, 2)
+            shared_revenue += main_share if main_id == trainer_id else assistant_share
+
     return {
         "trainer_id": trainer_id,
         "month": month,
-        "sessions": sessions,
-        "pt_revenue": to_rubles(pt_revenue),
+        "sessions": solo_sessions + shared_sessions,
+        "pt_revenue": to_rubles(solo_revenue + shared_revenue),
     }
 
 
