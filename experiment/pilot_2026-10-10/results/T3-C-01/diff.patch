+class AssistantTrainerTest(unittest.TestCase):
+    """Тренировки вдвоём: trainer_id=1 и trainer_id=2 — пара, оба из club_id=1 (см. fixtures/raw/demo)."""
+
+    def setUp(self):
+        self.conn, self.cfg, _ = demo_db()
+        # Три тренировки вдвоём пары (1, 2) в июле + одна одиночная тренировка трейнера 1.
+        # По 1001 копейке, чтобы split_evenly давал [501, 500] (лишняя копейка основному).
+        self.conn.executemany(
+            "INSERT INTO sales VALUES (?, ?, ?, ?, ?, ?, ?)",
+            [
+                (101, 1, 1, "2026-07-01", "personal_training", 100000, "own"),  # одиночная
+                (102, 1, 2, "2026-07-02", "personal_training", 1001, "own"),
+                (103, 1, 1, "2026-07-03", "personal_training", 1001, "own"),
+                (104, 1, 2, "2026-07-04", "personal_training", 1001, "own"),
+            ],
+        )
+        self.conn.executemany(
+            "INSERT INTO sessions VALUES (?, ?, ?, ?, ?, ?, ?)",
+            [
+                (101, 1, 1, 1, "2026-07-01", 101, None),
+                (102, 1, 1, 2, "2026-07-02", 102, 2),
+                (103, 1, 1, 1, "2026-07-03", 103, 2),
+                (104, 1, 1, 2, "2026-07-04", 104, 2),
+            ],
+        )
+        self.conn.commit()
+
+    def test_main_trainer_gets_solo_plus_alternating_shared(self):
+        report = trainer_monthly_report(self.conn, self.cfg, 1, "2026-07")
+        # 1 одиночная + тренировки вдвоём №1 и №3 (по очереди в паре) = 3
+        self.assertEqual(report["sessions"], 3)
+        # 100000 (solo) + 501 за каждую из 3 тренировок вдвоём (основному — лишняя копейка)
+        self.assertEqual(report["pt_revenue"], to_rubles(100000 + 501 * 3))
+
+    def test_assistant_trainer_gets_remaining_shared_session(self):
+        report = trainer_monthly_report(self.conn, self.cfg, 2, "2026-07")
+        # только тренировка вдвоём №2 (по очереди в паре)
+        self.assertEqual(report["sessions"], 1)
+        self.assertEqual(report["pt_revenue"], to_rubles(500 + 500 + 500))
+
+    def test_shared_sessions_not_duplicated_at_club_level(self):
+        club = club_monthly_report(self.conn, self.cfg, 1, "2026-07")
+        # 4 строки sessions в июле для club_id=1 — ни одна не задвоена
+        self.assertEqual(club["pt_sessions"], 4)
+
+    def test_self_assist_counts_as_solo(self):
+        self.conn.execute(
+            "INSERT INTO sales VALUES (?, ?, ?, ?, ?, ?, ?)",
+            (105, 1, 1, "2026-07-05", "personal_training", 50000, "own"),
+        )
+        self.conn.execute(
+            "INSERT INTO sessions VALUES (?, ?, ?, ?, ?, ?, ?)",
+            (105, 1, 1, 1, "2026-07-05", 105, 1),
+        )
+        self.conn.commit()
+        report = trainer_monthly_report(self.conn, self.cfg, 1, "2026-07")
+        self.assertEqual(report["sessions"], 4)
+        self.assertEqual(report["pt_revenue"], to_rubles(100000 + 501 * 3 + 50000))
+
+
