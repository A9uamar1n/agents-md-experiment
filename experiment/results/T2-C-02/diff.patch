+def _trial_conversion(conn: sqlite3.Connection, club_id: int, start: str, end: str) -> float | None:
+    """Доля когорты месяца (первый пробный визит в клубе), купившей абонемент
+    в день визита или в следующие 14 дней. None, если когорта пустая."""
+    cohort_size, converted = conn.execute(
+        """
+        WITH first_trial AS (
+            SELECT person_id, MIN(visit_date) AS first_date
+            FROM visits
+            WHERE club_id = ? AND visit_type IN ('trial', 'guest_pass')
+            GROUP BY person_id
+        )
+        SELECT
+            COUNT(*),
+            SUM(CASE WHEN EXISTS (
+                SELECT 1 FROM sales s
+                WHERE s.club_id = ? AND s.person_id = first_trial.person_id AND s.kind = 'membership'
+                  AND s.sale_date >= first_trial.first_date
+                  AND s.sale_date <= date(first_trial.first_date, '+14 days')
+            ) THEN 1 ELSE 0 END)
+        FROM first_trial
+        WHERE first_date >= ? AND first_date < ?
+        """,
+        (club_id, club_id, start, end),
+    ).fetchone()
+    if not cohort_size:
+        return None
+    return round((converted or 0) / cohort_size, 3)
+
+
 def club_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, club_id: int, month: str) -> dict:
