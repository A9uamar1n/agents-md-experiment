diff --git a/fitstat/reports.py b/fitstat/reports.py
index 56b08ef..972d37e 100755
--- a/fitstat/reports.py
+++ b/fitstat/reports.py
@@ -7,7 +7,7 @@ from __future__ import annotations
 import sqlite3
 
 from fitstat.config import ClientConfig
-from fitstat.money import to_rubles
+from fitstat.money import split_evenly, to_rubles
 
 
 def _month_bounds(month: str) -> tuple[str, str]:
@@ -72,26 +72,39 @@ def club_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, club_id: in
 
 
 def trainer_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, trainer_id: int, month: str) -> dict:
+    """Тренировки вдвоём (assistant_trainer_id) засчитываются обоим тренерам:
+    сессия входит в sessions каждого из них, а pt_revenue делится между ними
+    поровну (split_evenly — лишняя копейка уходит основному тренеру)."""
     start, end = _month_bounds(month)
-    period = (trainer_id, start, end)
+    period = (trainer_id, trainer_id, start, end)
 
     sessions = _scalar(
         conn,
-        "SELECT COUNT(*) FROM sessions WHERE trainer_id = ? AND session_date >= ? AND session_date < ?",
+        "SELECT COUNT(*) FROM sessions"
+        " WHERE (trainer_id = ? OR assistant_trainer_id = ?) AND session_date >= ? AND session_date < ?",
         period,
     )
-    pt_revenue = _scalar(
-        conn,
-        "SELECT SUM(s.amount_kop) FROM sessions ss JOIN sales s ON s.id = ss.sale_id"
-        " WHERE ss.trainer_id = ? AND ss.session_date >= ? AND ss.session_date < ?",
+    rows = conn.execute(
+        "SELECT ss.trainer_id, ss.assistant_trainer_id, s.amount_kop"
+        " FROM sessions ss JOIN sales s ON s.id = ss.sale_id"
+        " WHERE (ss.trainer_id = ? OR ss.assistant_trainer_id = ?)"
+        " AND ss.session_date >= ? AND ss.session_date < ?",
         period,
-    )
+    ).fetchall()
+
+    pt_revenue_kop = 0
+    for main_id, assistant_id, amount_kop in rows:
+        if assistant_id:
+            main_share, assistant_share = split_evenly(amount_kop, 2)
+            pt_revenue_kop += main_share if trainer_id == main_id else assistant_share
+        else:
+            pt_revenue_kop += amount_kop
 
     return {
         "trainer_id": trainer_id,
         "month": month,
         "sessions": sessions,
-        "pt_revenue": to_rubles(pt_revenue),
+        "pt_revenue": to_rubles(pt_revenue_kop),
     }
 
 
