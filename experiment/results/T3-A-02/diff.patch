+class AssistantTrainerReportTest(unittest.TestCase):
+    """Тренировки вдвоём (assistant_trainer_id) должны засчитываться обоим тренерам,
+    а выручка — делиться между ними поровну."""
+
+    def setUp(self):
+        self.conn = connect()
+        create_schema(self.conn)
+        # club/trainers/persons не нужны: trainer_monthly_report их не читает
+        self.conn.executemany(
+            "INSERT INTO sales VALUES (?, ?, ?, ?, ?, ?, ?)",
+            [
+                (1, 1, 1, "2026-05-07", "personal_training", 1001, "own"),  # нечётная сумма
+                (2, 1, 2, "2026-05-10", "personal_training", 2000, "own"),  # сольная тренировка
+            ],
+        )
+        self.conn.executemany(
+            "INSERT INTO sessions VALUES (?, ?, ?, ?, ?, ?, ?)",
+            [
+                (1, 1, 10, 1, "2026-05-07", 1, 20),  # тренер 10 + ассистент 20
+                (2, 1, 10, 2, "2026-05-10", 2, None),  # обычная тренировка тренера 10
+            ],
+        )
+        self.conn.commit()
+
+    def test_main_trainer_gets_own_sessions_plus_half_of_shared(self):
+        report = trainer_monthly_report(self.conn, None, 10, "2026-05")
+        self.assertEqual(report["sessions"], 2)
+        self.assertEqual(report["pt_revenue"], 25.01)  # 5.01 (501 коп, лишняя копейка) + 20.00
+
+    def test_assistant_trainer_gets_only_shared_session(self):
+        report = trainer_monthly_report(self.conn, None, 20, "2026-05")
+        self.assertEqual(report["sessions"], 1)
+        self.assertEqual(report["pt_revenue"], 5.0)  # 500 из 1001 копеек
+
+
