+class AssistedSessionReportTest(unittest.TestCase):
+    """Тренировки вдвоём: trainer_id=1 (основной) и assistant_trainer_id=2 делят
+    три совместные тренировки (1001 / 1000 / 777 коп.) плюс у трейнера 1 своя
+    одиночная тренировка на 2000 коп.
+    """
+
+    def setUp(self):
+        self.conn = connect()
+        create_schema(self.conn)
+        self.conn.executemany(
+            "INSERT INTO sales VALUES (?, 1, NULL, '2026-07-01', 'personal_training', ?, 'own')",
+            [(101, 1001), (102, 1000), (103, 777), (104, 2000)],
+        )
+        self.conn.executemany(
+            "INSERT INTO sessions VALUES (?, 1, ?, 1, '2026-07-0' || ?, ?, ?)",
+            [
+                (1, 1, "1", 101, 2),  # trainer 1 + assistant 2, очередь: достаётся основному (1)
+                (2, 1, "2", 102, 2),  # очередь: достаётся ассистенту (2)
+                (3, 1, "3", 103, 2),  # очередь: снова основному (1)
+                (4, 1, "4", 104, None),  # одиночная тренировка трейнера 1
+            ],
+        )
+        self.conn.commit()
+
+    def test_sessions_split_by_turn(self):
+        trainer1 = trainer_monthly_report(self.conn, None, 1, "2026-07")
+        trainer2 = trainer_monthly_report(self.conn, None, 2, "2026-07")
+        self.assertEqual(trainer1["sessions"], 3)  # 2 совместных (очередь) + 1 своя
+        self.assertEqual(trainer2["sessions"], 1)
+
+    def test_revenue_split_in_half_with_extra_kopeck_to_main(self):
+        trainer1 = trainer_monthly_report(self.conn, None, 1, "2026-07")
+        trainer2 = trainer_monthly_report(self.conn, None, 2, "2026-07")
+        # совместные: (501+500)+(500+500)+(389+388), своя: 2000 — трейнеру 1
+        self.assertEqual(trainer1["pt_revenue"], 33.90)
+        self.assertEqual(trainer2["pt_revenue"], 13.88)
+        self.assertEqual(trainer1["pt_revenue"] + trainer2["pt_revenue"], 47.78)
+
+    def test_club_pt_sessions_not_doubled(self):
+        club = club_monthly_report(self.conn, None, 1, "2026-07")
+        self.assertEqual(club["pt_sessions"], 4)
+
+
