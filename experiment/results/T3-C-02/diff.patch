+def _assisted_credit(conn: sqlite3.Connection, trainer_id: int, start: str, end: str) -> tuple[int, int]:
+    """Тренировки вдвоём: счёт тренировки по очереди уходит одному из пары (разница в паре
+    не больше одной тренировки), а выручка каждой такой тренировки делится поровну между
+    парой, лишняя копейка — основному тренеру этой тренировки.
+    """
+    rows = conn.execute(
+        "SELECT ss.trainer_id, ss.assistant_trainer_id, s.amount_kop"
+        " FROM sessions ss JOIN sales s ON s.id = ss.sale_id"
+        " WHERE ss.assistant_trainer_id IS NOT NULL"
+        " AND ss.session_date >= ? AND ss.session_date < ?"
+        " AND (ss.trainer_id = ? OR ss.assistant_trainer_id = ?)"
+        " ORDER BY ss.session_date, ss.id",
+        (start, end, trainer_id, trainer_id),
+    ).fetchall()
+
+    pairs: dict[tuple[int, int], list[tuple[int, int, int]]] = {}
+    for main_id, assistant_id, amount_kop in rows:
+        pair_key = (min(main_id, assistant_id), max(main_id, assistant_id))
+        pairs.setdefault(pair_key, []).append((main_id, assistant_id, amount_kop))
+
+    sessions = 0
+    revenue = 0
+    for (lo, hi), pair_rows in pairs.items():
+        for index, (main_id, assistant_id, amount_kop) in enumerate(pair_rows):
+            turn_winner = lo if index % 2 == 0 else hi
+            if turn_winner == trainer_id:
+                sessions += 1
+
+            main_share, assistant_share = split_evenly(amount_kop, 2)
+            if trainer_id == main_id:
+                revenue += main_share
+            elif trainer_id == assistant_id:
+                revenue += assistant_share
+
+    return sessions, revenue
+
+
