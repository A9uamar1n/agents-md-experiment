+def _trial_conversion(conn: sqlite3.Connection, club_id: int, start: str, end: str) -> float | None:
+    """Доля когорты месяца (первый пробный визит в клубе), купившей абонемент
+    в день визита или в следующие 14 календарных дней. См. docs/metrics.md."""
+    cohort_size, converted = conn.execute(
+        """
+        WITH first_trial AS (
+            SELECT person_id, MIN(visit_date) AS first_date
+            FROM visits
+            WHERE club_id = ? AND visit_type IN ('trial', 'guest_pass')
+            GROUP BY person_id
+        ),
+        cohort AS (
+            SELECT person_id, first_date FROM first_trial
+            WHERE first_date >= ? AND first_date < ?
+        )
+        SELECT
+            COUNT(*),
+            SUM(CASE WHEN EXISTS (
+                SELECT 1 FROM sales s
+                WHERE s.club_id = ?
+                  AND s.person_id = cohort.person_id
+                  AND s.kind = 'membership'
+                  AND s.sale_date >= cohort.first_date
+                  AND s.sale_date <= date(cohort.first_date, '+14 days')
+            ) THEN 1 ELSE 0 END)
+        FROM cohort
+        """,
+        (club_id, start, end, club_id),
+    ).fetchone()
+
+    if not cohort_size:
+        return None
+    return round((converted or 0) / cohort_size, 3)
+
