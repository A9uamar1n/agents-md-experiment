+def _excluded_sale_kinds(cfg: ClientConfig, club_id: int, start: str) -> list[str]:
+    """Виды продаж, которые по настройке клуба (`clients/<client>.toml`) не входят в revenue с указанной даты."""
+    club = cfg.club(club_id)
+    kinds = club.get("exclude_sale_kinds")
+    since = club.get("exclude_sale_kinds_since")
+    if kinds and since and start >= since:
+        return list(kinds)
+    return []
