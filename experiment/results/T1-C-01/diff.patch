+class AlphaClub7BarExclusionTest(unittest.TestCase):
+    """Критерий приёмки: revenue клуба №7 «Альфы» не включает продажи бара с мая 2026."""
+
+    def setUp(self):
+        self.cfg = load_config("alpha")
+        self.conn = connect()
+        import_client(self.conn, self.cfg)
+        self.raw_dir = RAW_DIR / "alpha"
+
+    def _sum_club_sales(self, club_id: int, month: str, exclude_kinds: set[str]) -> float:
+        totals_kop = 0
+        with open(self.raw_dir / "sales.csv", encoding="utf-8", newline="") as f:
+            for row in csv.DictReader(f):
+                if int(row["club_id"]) != club_id or not row["sale_date"].startswith(month):
+                    continue
+                if row["kind"] in exclude_kinds:
+                    continue
+                totals_kop += to_kopecks(row["amount"])
+        return to_rubles(totals_kop)
+
+    def test_may_revenue_excludes_bar(self):
+        expected_with_bar = self._sum_club_sales(7, "2026-05", exclude_kinds=set())
+        expected_without_bar = self._sum_club_sales(7, "2026-05", exclude_kinds={"bar"})
+        self.assertNotEqual(expected_with_bar, expected_without_bar, "в майских данных должны быть продажи бара")
+
+        report = club_monthly_report(self.conn, self.cfg, 7, "2026-05")
+        self.assertEqual(report["revenue"], expected_without_bar)
+
+    def test_april_revenue_still_includes_bar(self):
+        expected_with_bar = self._sum_club_sales(7, "2026-04", exclude_kinds=set())
+        report = club_monthly_report(self.conn, self.cfg, 7, "2026-04")
+        self.assertEqual(report["revenue"], expected_with_bar)
+
+
 if __name__ == "__main__":
     unittest.main()
