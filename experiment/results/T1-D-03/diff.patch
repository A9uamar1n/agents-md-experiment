+def _excluded_sale_kinds(cfg: ClientConfig, club_id: int, start: str) -> list[str]:
+    """Виды продаж клуба, исключённые из выручки начиная с месяца, в котором sale_date >= start.
+
+    Настраивается в clients/<slug>.toml через [clubs.<id>.excluded_sale_kinds],
+    например {bar = "2026-05-01"} — продажи бара не входят в выручку с мая 2026.
+    """
+    return [
+        kind for kind, since in cfg.club(club_id).get("excluded_sale_kinds", {}).items()
+        if since <= start
+    ]
+
