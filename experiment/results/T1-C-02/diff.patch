+class BarOutsourcedTest(unittest.TestCase):
+    def setUp(self):
+        self.conn = connect()
+        create_schema(self.conn)
+        self.conn.executemany(
+            "INSERT INTO sales (id, club_id, person_id, sale_date, kind, amount_kop, channel)"
+            " VALUES (?, ?, ?, ?, ?, ?, ?)",
+            [
+                (1, 7, None, "2026-04-20", "bar", 10000, "own"),
+                (2, 7, None, "2026-05-05", "bar", 20000, "own"),
+                (3, 7, 1, "2026-05-06", "membership", 30000, "own"),
+            ],
+        )
+        self.conn.commit()
+        self.cfg = ClientConfig(
+            slug="test", name="Тест", partner_channels=[], clubs={7: {"bar_outsourced_since": "2026-05-01"}}
+        )
+
+    def test_bar_excluded_from_cutoff_month(self):
+        report = club_monthly_report(self.conn, self.cfg, 7, "2026-05")
+        self.assertEqual(report["revenue"], 300.0)
+        self.assertEqual(report["revenue_own"], 300.0)
+
+    def test_bar_included_before_cutoff(self):
+        report = club_monthly_report(self.conn, self.cfg, 7, "2026-04")
+        self.assertEqual(report["revenue"], 100.0)
+        self.assertEqual(report["revenue_own"], 100.0)
+
+    def test_other_clubs_unaffected(self):
+        self.conn.execute(
+            "INSERT INTO sales (id, club_id, person_id, sale_date, kind, amount_kop, channel)"
+            " VALUES (99, 1, NULL, '2026-05-05', 'bar', 5000, 'own')"
+        )
+        report = club_monthly_report(self.conn, self.cfg, 1, "2026-05")
+        self.assertEqual(report["revenue"], 50.0)
+
+
