     return conn.execute(sql, params).fetchone()[0] or 0
 
 
+def _trial_conversion(conn: sqlite3.Connection, club_id: int, start: str, end: str) -> float | None:
+    """Доля когорты месяца (первый пробный визит в этом клубе), купившей абонемент
+    в день первого пробного визита или в следующие 14 календарных дней."""
+    first_trials = conn.execute(
+        "SELECT person_id, MIN(visit_date) FROM visits"
+        " WHERE club_id = ? AND visit_type IN ('trial', 'guest_pass')"
+        " GROUP BY person_id",
+        (club_id,),
+    ).fetchall()
+    cohort = [(person_id, first_date) for person_id, first_date in first_trials if start <= first_date < end]
+    if not cohort:
+        return None
+
+    converted = 0
+    for person_id, first_date in cohort:
+        window_end = (datetime.date.fromisoformat(first_date) + datetime.timedelta(days=14)).isoformat()
+        bought = conn.execute(
+            "SELECT 1 FROM sales WHERE club_id = ? AND person_id = ? AND kind = 'membership'"
+            " AND sale_date >= ? AND sale_date <= ? LIMIT 1",
+            (club_id, person_id, first_date, window_end),
+        ).fetchone()
+        if bought:
+            converted += 1
+
+    return round(converted / len(cohort), 3)
+
