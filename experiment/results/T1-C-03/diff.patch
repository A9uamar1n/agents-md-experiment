+def _exclude_sale_kinds_clause(cfg: ClientConfig, club_id: int) -> tuple[str, list]:
+    """Клуб может исключать из выручки отдельные виды продаж с определённой даты
+    (`[clubs.<id>.excluded_sale_kinds]` в конфиге клиента, вид -> дата начала)."""
+    excluded = cfg.club(club_id).get("excluded_sale_kinds", {})
+    clause = ""
+    params: list = []
+    for kind, since in excluded.items():
+        clause += " AND NOT (kind = ? AND sale_date >= ?)"
+        params.extend([kind, since])
+    return clause, params
+
+
