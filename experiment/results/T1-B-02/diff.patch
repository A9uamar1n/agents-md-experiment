+class BarExcludedSinceTest(unittest.TestCase):
+    """Клуб с bar_excluded_since в конфиге: продажи 'bar' перестают быть доходом с этого месяца."""
+
+    def setUp(self):
+        self.conn = connect()
+        create_schema(self.conn)
+        self.conn.execute("INSERT INTO clubs VALUES (1, 'Клуб', '2020-01-01')")
+        self.conn.executemany(
+            "INSERT INTO sales (id, club_id, person_id, sale_date, kind, amount_kop, channel)"
+            " VALUES (?, ?, ?, ?, ?, ?, ?)",
+            [
+                (1, 1, None, "2026-04-20", "bar", 10000, "own"),
+                (2, 1, None, "2026-05-05", "bar", 20000, "own"),
+                (3, 1, 1, "2026-05-10", "membership", 50000, "own"),
+            ],
+        )
+        self.conn.commit()
+        self.cfg = ClientConfig(
+            slug="demo2", name="Демо2", partner_channels=[], clubs={1: {"bar_excluded_since": "2026-05-01"}}
+        )
+
+    def test_bar_excluded_from_target_month(self):
+        report = club_monthly_report(self.conn, self.cfg, 1, "2026-05")
+        self.assertEqual(report["revenue"], 500.0)
+        self.assertEqual(report["revenue_own"], 500.0)
+
+    def test_bar_still_counted_before_exclusion(self):
+        report = club_monthly_report(self.conn, self.cfg, 1, "2026-04")
+        self.assertEqual(report["revenue"], 100.0)
+        self.assertEqual(report["revenue_own"], 100.0)
+
+
 if __name__ == "__main__":
     unittest.main()
