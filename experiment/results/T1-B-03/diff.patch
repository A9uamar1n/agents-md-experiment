-        period,
-    )
+    excluded_kinds = _revenue_excluded_kinds(cfg, club_id, start)
+    if excluded_kinds:
+        placeholders = ",".join("?" * len(excluded_kinds))
+        revenue = _scalar(
+            conn,
+            "SELECT SUM(amount_kop) FROM sales WHERE club_id = ? AND sale_date >= ? AND sale_date < ?"
+            f" AND kind NOT IN ({placeholders})",
+            period + tuple(excluded_kinds),
+        )
+    else:
+        revenue = _scalar(
+            conn,
+            "SELECT SUM(amount_kop) FROM sales WHERE club_id = ? AND sale_date >= ? AND sale_date < ?",
