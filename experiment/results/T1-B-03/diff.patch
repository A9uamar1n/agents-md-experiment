@@ -21,15 +21,38 @@ def _scalar(conn: sqlite3.Connection, sql: str, params: tuple) -> int:
     return conn.execute(sql, params).fetchone()[0] or 0
 
 
+def _revenue_excluded_kinds(cfg: ClientConfig, club_id: int, start: str) -> list[str]:
+    """Виды продаж, которые с какого-то месяца перестали быть выручкой клуба
+
+    (например, бар сдан в аренду стороннему оператору) — настраивается в
+    clients/<client>.toml через revenue_exclude_kinds/revenue_exclude_since.
+    """
+    club_cfg = cfg.club(club_id)
+    since = club_cfg.get("revenue_exclude_since")
+    if since and since <= start:
+        return club_cfg.get("revenue_exclude_kinds", [])
+    return []
+
+
 def club_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, club_id: int, month: str) -> dict:
     start, end = _month_bounds(month)
     period = (club_id, start, end)
 
-    revenue = _scalar(
