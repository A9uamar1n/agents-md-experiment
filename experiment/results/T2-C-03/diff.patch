     return conn.execute(sql, params).fetchone()[0] or 0
 
 
+def _trial_conversion(conn: sqlite3.Connection, club_id: int, start: str, end: str) -> float | None:
+    """Доля когорты месяца, купившей абонемент в этом клубе в день первого
+    пробного визита (за всю историю, в любом клубе) или в следующие 14 дней.
+    """
+    cohort_size, converted = conn.execute(
+        """
+        WITH global_first AS (
+            SELECT person_id, MIN(visit_date) AS first_date
+            FROM visits
+            WHERE visit_type IN ('trial', 'guest_pass')
+            GROUP BY person_id
+        ),
+        cohort AS (
+            SELECT v.person_id, v.visit_date AS first_date
+            FROM visits v
+            JOIN global_first gf
+                ON gf.person_id = v.person_id AND gf.first_date = v.visit_date
+            WHERE v.club_id = ?
+                AND v.visit_type IN ('trial', 'guest_pass')
+                AND v.visit_date >= ? AND v.visit_date < ?
+        )
+        SELECT
+            COUNT(*),
+            SUM(CASE WHEN EXISTS (
+                SELECT 1 FROM sales s
+                WHERE s.club_id = ?
+                    AND s.person_id = cohort.person_id
+                    AND s.kind = 'membership'
+                    AND s.sale_date >= cohort.first_date
+                    AND s.sale_date <= date(cohort.first_date, '+14 days')
+            ) THEN 1 ELSE 0 END)
+        FROM cohort
+        """,
+        (club_id, start, end, club_id),
+    ).fetchone()
+
+    if not cohort_size:
+        return None
+    return round(converted / cohort_size, 3)
+
+
 def club_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, club_id: int, month: str) -> dict:
