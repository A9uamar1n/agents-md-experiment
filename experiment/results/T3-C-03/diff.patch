+class JointSessionTrainerReportTest(unittest.TestCase):
+    """Тренировки вдвоём: trainer_id=1 основной, assistant_trainer_id=2 — во всех, кроме одной (соло)."""
+
+    def setUp(self):
+        self.conn = connect()
+        create_schema(self.conn)
+        self.conn.executemany(
+            "INSERT INTO sales VALUES (?, ?, ?, ?, ?, ?, ?)",
+            [
+                (1, 1, 1, "2026-05-01", "personal_training", 10000, "own"),
+                (2, 1, 1, "2026-05-02", "personal_training", 10001, "own"),
+                (3, 1, 1, "2026-05-03", "personal_training", 10000, "own"),
+                (4, 1, 1, "2026-05-04", "personal_training", 5000, "own"),
+            ],
+        )
+        self.conn.executemany(
+            "INSERT INTO sessions VALUES (?, ?, ?, ?, ?, ?, ?)",
+            [
+                (1, 1, 1, 1, "2026-05-01", 1, 2),
+                (2, 1, 1, 1, "2026-05-02", 2, 2),
+                (3, 1, 1, 1, "2026-05-03", 3, 2),
+                (4, 1, 1, 1, "2026-05-04", 4, None),
+            ],
+        )
+        self.conn.commit()
+
+    def test_sessions_alternate_between_the_pair(self):
+        main = trainer_monthly_report(self.conn, None, 1, "2026-05")
+        assistant = trainer_monthly_report(self.conn, None, 2, "2026-05")
+
+        # 3 совместные тренировки распределяются по очереди (2 основному, 1 второму) + 1 своя.
+        self.assertEqual(main["sessions"], 3)
+        self.assertEqual(assistant["sessions"], 1)
+        # строки не дублируются: сумма по тренерам равна числу тренировок.
+        self.assertEqual(main["sessions"] + assistant["sessions"], 4)
+
+    def test_revenue_split_evenly_with_remainder_to_main(self):
+        main = trainer_monthly_report(self.conn, None, 1, "2026-05")
+        assistant = trainer_monthly_report(self.conn, None, 2, "2026-05")
+
+        self.assertEqual(main["pt_revenue"], 200.01)
+        self.assertEqual(assistant["pt_revenue"], 150.0)
+
+    def test_club_report_counts_each_training_once(self):
+        club = club_monthly_report(self.conn, None, 1, "2026-05")
+        self.assertEqual(club["pt_sessions"], 4)
+
+
