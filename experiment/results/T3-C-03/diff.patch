 def trainer_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, trainer_id: int, month: str) -> dict:
+    """Тренировки вдвоём (assistant_trainer_id) делятся между парой тренеров:
+    pt_revenue — поровну, лишняя копейка основному тренеру; sessions — по очереди,
+    так что за месяц разница между парой не больше одной тренировки.
+    """
     start, end = _month_bounds(month)
     period = (trainer_id, start, end)
 
-    sessions = _scalar(
+    solo_sessions = _scalar(
         conn,
-        "SELECT COUNT(*) FROM sessions WHERE trainer_id = ? AND session_date >= ? AND session_date < ?",
+        "SELECT COUNT(*) FROM sessions"
+        " WHERE trainer_id = ? AND assistant_trainer_id IS NULL"
+        " AND session_date >= ? AND session_date < ?",
         period,
     )
-    pt_revenue = _scalar(
+    solo_revenue = _scalar(
         conn,
         "SELECT SUM(s.amount_kop) FROM sessions ss JOIN sales s ON s.id = ss.sale_id"
-        " WHERE ss.trainer_id = ? AND ss.session_date >= ? AND ss.session_date < ?",
+        " WHERE ss.trainer_id = ? AND ss.assistant_trainer_id IS NULL"
+        " AND ss.session_date >= ? AND ss.session_date < ?",
         period,
     )
 
+    joint_rows = conn.execute(
+        "SELECT ss.trainer_id, ss.assistant_trainer_id, s.amount_kop"
+        " FROM sessions ss JOIN sales s ON s.id = ss.sale_id"
+        " WHERE ss.assistant_trainer_id IS NOT NULL"
+        " AND (ss.trainer_id = ? OR ss.assistant_trainer_id = ?)"
+        " AND ss.session_date >= ? AND ss.session_date < ?"
+        " ORDER BY ss.id",
+        (trainer_id, trainer_id, start, end),
+    ).fetchall()
+
+    turns: dict[tuple[int, int], int] = {}
+    joint_sessions = 0
+    joint_revenue = 0
+    for main_id, assistant_id, amount_kop in joint_rows:
+        pair = (main_id, assistant_id) if main_id < assistant_id else (assistant_id, main_id)
+        turn = turns.get(pair, 0)
+        turns[pair] = turn + 1
+        winner = main_id if turn % 2 == 0 else assistant_id
+        if winner == trainer_id:
+            joint_sessions += 1
+
+        main_share, assistant_share = split_evenly(amount_kop, 2)
+        if trainer_id == main_id:
+            joint_revenue += main_share
+        elif trainer_id == assistant_id:
+            joint_revenue += assistant_share
+
     return {
         "trainer_id": trainer_id,
         "month": month,
-        "sessions": sessions,
-        "pt_revenue": to_rubles(pt_revenue),
+        "sessions": solo_sessions + joint_sessions,
+        "pt_revenue": to_rubles(solo_revenue + joint_revenue),
     }
 
 
