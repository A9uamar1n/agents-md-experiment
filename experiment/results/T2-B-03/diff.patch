     return conn.execute(sql, params).fetchone()[0] or 0
 
 
+def _trial_conversion(conn: sqlite3.Connection, club_id: int, start: str, end: str) -> float | None:
+    """Доля когорты месяца (первый пробный визит в клубе), купившей абонемент
+    в день первого пробного визита или в следующие 14 календарных дней."""
+    cohort_size, converted = conn.execute(
+        """
+        WITH first_trial AS (
+            SELECT person_id, MIN(visit_date) AS first_trial_date
+            FROM visits
+            WHERE club_id = ? AND visit_type IN ('trial', 'guest_pass')
+            GROUP BY person_id
+        )
+        SELECT
+            COUNT(*),
+            SUM(CASE WHEN EXISTS (
+                SELECT 1 FROM sales
+                WHERE sales.club_id = ?
+                  AND sales.person_id = first_trial.person_id
+                  AND sales.kind = 'membership'
+                  AND sales.sale_date >= first_trial.first_trial_date
+                  AND sales.sale_date <= date(first_trial.first_trial_date, '+14 days')
+            ) THEN 1 ELSE 0 END)
+        FROM first_trial
+        WHERE first_trial_date >= ? AND first_trial_date < ?
+        """,
+        (club_id, club_id, start, end),
+    ).fetchone()
+    if not cohort_size:
+        return None
+    return round(converted / cohort_size, 3)
+
