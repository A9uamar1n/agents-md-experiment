     return conn.execute(sql, params).fetchone()[0] or 0
 
 
+def _revenue_excluded_kinds(cfg: ClientConfig, club_id: int, start: str) -> list[str]:
+    """Виды продаж, которые по конфигу клуба не входят в revenue клуба с даты start.
+
+    Настраивается в clients/<client>.toml через clubs.<id>.revenue_exclusions
+    (например, при сдаче бара клуба в аренду стороннему оператору).
+    """
+    exclusions = cfg.club(club_id).get("revenue_exclusions", [])
+    return [item["kind"] for item in exclusions if item["since"] <= start]
+
+
 def club_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, club_id: int, month: str) -> dict:
     start, end = _month_bounds(month)
     period = (club_id, start, end)
 
