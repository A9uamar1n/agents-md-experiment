-    )
+    revenue_sql = "SELECT SUM(amount_kop) FROM sales WHERE club_id = ? AND sale_date >= ? AND sale_date < ?"
+    revenue_params = period
+    excluded_kinds = _revenue_excluded_kinds(cfg, club_id, start)
+    if excluded_kinds:
+        placeholders = ", ".join("?" * len(excluded_kinds))
+        revenue_sql += f" AND kind NOT IN ({placeholders})"
+        revenue_params = period + tuple(excluded_kinds)
