+    def test_joint_sessions_split_round_robin_and_half_revenue(self):
+        # Июнь: тренер 1 и тренер 2 проводят вдвоём три тренировки (сессии 10, 11, 12,
+        # роли основной/второй в выгрузке чередуются) плюс у тренера 1 одна обычная (13).
+        main = trainer_monthly_report(self.conn, self.cfg, 1, "2026-06")
+        second = trainer_monthly_report(self.conn, self.cfg, 2, "2026-06")
+
+        # Круговая очередь по паре (1, 2): сессии 10 и 12 - тренеру 1, сессия 11 - тренеру 2.
+        # Плюс обычная сессия 13 - тренеру 1.
+        self.assertEqual(main["sessions"], 3)
+        self.assertEqual(second["sessions"], 1)
+
+        # Выручка делится пополам, нечётная копейка - основному тренеру строки:
+        # 1000.01 -> 500.01/500.00, 1500.00 -> 750.00/750.00, 2000.00 -> 1000.00/1000.00,
+        # плюс обычная тренировка 3000.00 целиком тренеру 1.
+        self.assertEqual(main["pt_revenue"], 5250.01)
+        self.assertEqual(second["pt_revenue"], 2250.0)
+
+    def test_joint_sessions_do_not_change_club_totals(self):
+        report = club_monthly_report(self.conn, self.cfg, 1, "2026-06")
+        self.assertEqual(report["pt_sessions"], 4)
+        self.assertEqual(report["pt_revenue"], 7500.01)
+
 
