 def _month_bounds(month: str) -> tuple[str, str]:
@@ -72,26 +72,58 @@ def club_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, club_id: in
 
 
 def trainer_monthly_report(conn: sqlite3.Connection, cfg: ClientConfig, trainer_id: int, month: str) -> dict:
+    """Совместные тренировки (assistant_trainer_id) делятся между основным и вторым тренером:
+    по количеству — по очереди, целыми тренировками, так что за месяц разница между
+    парой тренеров не больше одной тренировки; по выручке — пополам, нечётная копейка
+    основному тренеру (см. docs/metrics.md). Запись с assistant_trainer_id = trainer_id
+    (ошибка выгрузки) считаем обычной тренировкой без второго тренера.
+    """
     start, end = _month_bounds(month)
     period = (trainer_id, start, end)
 
-    sessions = _scalar(
+    solo_sessions = _scalar(
         conn,
-        "SELECT COUNT(*) FROM sessions WHERE trainer_id = ? AND session_date >= ? AND session_date < ?",
+        "SELECT COUNT(*) FROM sessions WHERE trainer_id = ? AND session_date >= ? AND session_date < ?"
+        " AND (assistant_trainer_id IS NULL OR assistant_trainer_id = trainer_id)",
         period,
     )
-    pt_revenue = _scalar(
+    solo_revenue = _scalar(
         conn,
         "SELECT SUM(s.amount_kop) FROM sessions ss JOIN sales s ON s.id = ss.sale_id"
-        " WHERE ss.trainer_id = ? AND ss.session_date >= ? AND ss.session_date < ?",
+        " WHERE ss.trainer_id = ? AND ss.session_date >= ? AND ss.session_date < ?"
+        " AND (ss.assistant_trainer_id IS NULL OR ss.assistant_trainer_id = ss.trainer_id)",
         period,
     )
 
+    joint_rows = conn.execute(
+        "SELECT ss.trainer_id, ss.assistant_trainer_id, s.amount_kop"
+        " FROM sessions ss JOIN sales s ON s.id = ss.sale_id"
+        " WHERE (ss.trainer_id = ? OR ss.assistant_trainer_id = ?)"
+        " AND ss.assistant_trainer_id IS NOT NULL AND ss.assistant_trainer_id != ss.trainer_id"
+        " AND ss.session_date >= ? AND ss.session_date < ?"
+        " ORDER BY ss.session_date, ss.id",
+        (trainer_id, trainer_id, start, end),
+    ).fetchall()
+
+    joint_sessions = 0
+    joint_revenue = 0
+    turn_by_pair: dict[frozenset, int] = {}
+    for main_id, assistant_id, amount_kop in joint_rows:
+        pair = frozenset((main_id, assistant_id))
+        turn = turn_by_pair.get(pair, 0)
+        turn_by_pair[pair] = turn + 1
+        low, high = sorted(pair)
+        if (low if turn % 2 == 0 else high) == trainer_id:
+            joint_sessions += 1
+
+        main_share, assistant_share = split_evenly(amount_kop, 2)
+        joint_revenue += main_share if trainer_id == main_id else assistant_share
+
     return {
         "trainer_id": trainer_id,
         "month": month,
-        "sessions": sessions,
-        "pt_revenue": to_rubles(pt_revenue),
+        "sessions": solo_sessions + joint_sessions,
+        "pt_revenue": to_rubles(solo_revenue + joint_revenue),
     }
 
 
