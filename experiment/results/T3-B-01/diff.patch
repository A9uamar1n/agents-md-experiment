+def _shared_sessions(conn: sqlite3.Connection, trainer_id: int, start: str, end: str) -> list[tuple]:
+    """Совместные тренировки тренера (в любой из двух ролей) за период, в хронологическом порядке."""
+    return conn.execute(
+        "SELECT ss.id, ss.trainer_id, ss.assistant_trainer_id, s.amount_kop"
+        " FROM sessions ss JOIN sales s ON s.id = ss.sale_id"
+        " WHERE (ss.trainer_id = ? OR ss.assistant_trainer_id = ?)"
+        "   AND ss.assistant_trainer_id IS NOT NULL"
+        "   AND ss.session_date >= ? AND ss.session_date < ?"
+        " ORDER BY ss.session_date, ss.id",
+        (trainer_id, trainer_id, start, end),
+    ).fetchall()
+
+
+def _shared_sessions_count(trainer_id: int, shared: list[tuple]) -> int:
+    """Делит совместные тренировки между парой тренеров по очереди (round-robin),
+    чтобы разница между ними не превышала одну тренировку за период."""
+    by_partner: dict[int, list[int]] = {}
+    for _session_id, main_id, assistant_id, _amount_kop in shared:
+        partner_id = assistant_id if main_id == trainer_id else main_id
+        by_partner.setdefault(partner_id, []).append(main_id)
+
+    count = 0
+    for partner_id, main_ids in by_partner.items():
+        starter, other = main_ids[0], partner_id if main_ids[0] == trainer_id else trainer_id
+        for i in range(len(main_ids)):
+            credited = starter if i % 2 == 0 else other
+            if credited == trainer_id:
+                count += 1
+    return count
+
+
+def _shared_sessions_revenue(trainer_id: int, shared: list[tuple]) -> int:
+    """Выручка с совместных тренировок делится поровну; лишняя копейка — основному тренеру."""
+    revenue = 0
+    for _session_id, main_id, _assistant_id, amount_kop in shared:
+        main_share, assistant_share = split_evenly(amount_kop, 2)
+        revenue += main_share if main_id == trainer_id else assistant_share
+    return revenue
+
+
