+def _trial_conversion(conn: sqlite3.Connection, club_id: int, start: str, end: str) -> float | None:
+    """Доля когорты месяца (первый пробный визит в [start, end)), купившей
+    абонемент в день первого пробного визита или в следующие 14 дней."""
+    row = conn.execute(
+        """
+        WITH trial_visits AS (
+            SELECT person_id, MIN(visit_date) AS first_trial_date
+            FROM visits
+            WHERE club_id = ?
+              AND (visit_type = 'trial'
+                   OR (visit_type = 'guest_pass' AND visit_date >= '2025-01-01'))
+            GROUP BY person_id
+        ),
+        cohort AS (
+            SELECT person_id, first_trial_date
+            FROM trial_visits
+            WHERE first_trial_date >= ? AND first_trial_date < ?
+        )
+        SELECT
+            COUNT(*),
+            SUM(CASE WHEN EXISTS (
+                SELECT 1 FROM sales s
+                WHERE s.club_id = ?
+                  AND s.person_id = cohort.person_id
+                  AND s.kind = 'membership'
+                  AND s.sale_date >= cohort.first_trial_date
+                  AND s.sale_date <= date(cohort.first_trial_date, '+14 days')
+            ) THEN 1 ELSE 0 END)
+        FROM cohort
+        """,
+        (club_id, start, end, club_id),
+    ).fetchone()
+    cohort_size, converted = row
+    if not cohort_size:
+        return None
+    return round(converted / cohort_size, 3)
+
